node_modules/
.DS_Store
*.log
.vite/
.claude/

# Employee master — 182 people's names, personal mobile numbers, emails and reporting lines.
# This repository is PUBLIC; that file is deliberately not committed. The team/admin module
# reads it locally. If it must be versioned, make the repo private first, or strip the
# Mobile NO column and commit only name / designation / department / location / work email.
source-documents/org/

.env

# ---- DnB-OS tracking engine: what must never be committed ----------------
# The append-only event log the tools fold into facts.json. 108 MB, which is
# over GitHub's 100 MB hard limit — so committing it does not fail at review,
# it fails at push. No browser reads it; tools/ingest.js rebuilds it.
tracking/engines/skf/events.jsonl
tracking/engines/skf/events.d/
tracking/engines/skf/backups/

# The shared plan/edit store, written at runtime by both apps. Committing it
# would ship one machine's corrections into everybody else's checkout.
tracking/engines/skf/sync/

# The project document store — pin photographs, 3D renders, CAD and contract
# files. ~1.6 GB, and it holds the signed client agreement, the client POs and
# a BOQ carrying our own cost beside the client price. THIS REPOSITORY IS
# PUBLIC, for the same reason the employee master above is excluded. Point
# DNBOS_PROJECT_DIR at it locally instead — see README.
tracking/projects/
# ---- projects made in this app ----------------------------------------
# The workspace store (api/workspace/projects.ts): every project created through
# the intake screen, with its BOQ package values and contract figures in it. Our
# own cost sits beside the client price in those, and THIS REPOSITORY IS PUBLIC
# — same reason the org master and the tracking sync store are excluded above.
# Anchored with a leading slash. Unanchored, `workspace/` matches a directory of
# that name at ANY depth — which also swallowed api/workspace/, the source folder
# holding the routes that do the saving. projects.ts was never committed once in
# the repo’s life because of it, so a fresh clone got an app whose save 404s.
/workspace/
