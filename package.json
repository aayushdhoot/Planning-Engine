{
  "name": "dnb-planning-engine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "sample": "vite-node scripts/sample-run.ts",
    "pdf": "node scripts/to-pdf.mjs",
    "gates": "npm run typecheck && npm run lint && npm run test && npm run build && npm run sample",
    "start": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "migrate": "vite-node scripts/migrate-to-supabase.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "dotenv": "^17.4.2",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vite-node": "^2.1.8",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
