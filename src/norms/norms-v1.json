    "partition": 63000,
    "ceiling": 37000,
    "electrical": 55000,
    "hvac": 65000,
    "plumbing": 12000,
    "sprinkler": 46000,
    "lv": 50000,
    "carpentry": 30000,
    "flooring": 55000,
    "painting": 15000,
    "glass": 43000,
    "modular": 73000,
    "finishing": 24000,
    "cleaning": 24000,
    "general": 49000
  },
  "physicalProductivity": {
    "_note": "Preferred duration driver when the BOQ carries QTY/UNIT columns: output per worker per working day, by trade. Applied per unit of physical quantity — duration = ceil(qty / (crew x perManDay)). Falls back to productivityInrPerManDay only when quantities are absent.",
